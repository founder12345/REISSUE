DATABASE_URL=postgresql://reissue:local-password@localhost:5432/reissue
APP_ORIGIN=http://localhost:3000
SEARCH_ANALYTICS=false
# Optional private S3-compatible storage for administrator image uploads.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Transactional email via Resend. Use a verified sender. Leave unset to disable new email accounts.
# MAIL_API_KEY=
# MAIL_FROM=REISSUE <no-reply@example.com>

# Google OAuth web client. Register the exact callback on each enabled origin.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PREVIEW_ENABLED=false

# Set these only after the operator reviews and approves the legal copy.
# LEGAL_APPROVED=false
# LEGAL_OPERATOR=
# LEGAL_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# TERMS_VERSION=

# Vercel Preview only. Use a database and credentials isolated from production.
# PREVIEW_DATABASE_URL=
